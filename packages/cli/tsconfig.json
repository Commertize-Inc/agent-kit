{
	"compilerOptions": {
		"target": "ES2023",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"erasableSyntaxOnly": true,
		"verbatimModuleSyntax": true,
		"rewriteRelativeImportExtensions": true,
		"declaration": true,
		"outDir": "dist",
		"rootDir": "src",
		"types": ["node"],
		"skipLibCheck": true
	},
	"include": ["src"]
}
