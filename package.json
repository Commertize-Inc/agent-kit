{
	"name": "commertize-agent-kit",
	"private": true,
	"license": "Apache-2.0",
	"type": "module",
	"workspaces": ["packages/cli"],
	"engines": {
		"node": ">=22.6"
	},
	"scripts": {
		"test": "node --conditions=source --experimental-strip-types --test --test-timeout=60000 packages/cli/test/*.test.ts",
		"typecheck": "tsc -p packages/cli/tsconfig.json --noEmit && tsc -p tsconfig.templates.json",
		"build": "npm run build --workspace @commertize/agent-kit",
		"check:wording": "node scripts/check-wording.mjs"
	},
	"devDependencies": {
		"@types/node": "22.20.5",
		"typescript": "5.9.3"
	}
}
